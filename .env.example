# Copy to .env.local. `npx convex dev` fills in the Convex values for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk dashboard -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# These live in Convex, not here. Set them with `npx convex env set NAME value`:
#   CLERK_JWT_ISSUER_DOMAIN       Clerk Frontend API URL
#   N8N_LOAN_EVENTS_WEBHOOK_URL   e.g. http://localhost:5678/webhook/lendloop-loan-events
#   N8N_WEBHOOK_SECRET            signs Convex -> n8n calls
#   CONVEX_WEBHOOK_SECRET         verifies n8n -> Convex calls
