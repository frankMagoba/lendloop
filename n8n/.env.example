# Copy to n8n/.env. Generate secrets with: openssl rand -hex 32

# Encrypts the credentials n8n stores. Keep it stable or n8n can't read them.
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Europe/London
TZ=Europe/London

# Must match the Convex env vars of the same name.
N8N_WEBHOOK_SECRET=
CONVEX_WEBHOOK_SECRET=

# Convex HTTP actions URL. For the local Convex backend on your machine use
# http://host.docker.internal:3211, otherwise https://<deployment>.convex.site
CONVEX_SITE_URL=http://host.docker.internal:3211

LENDLOOP_APP_URL=http://localhost:3000
LENDLOOP_FROM_EMAIL=lendloop@example.com
LENDLOOP_OPS_EMAIL=ops@example.com
