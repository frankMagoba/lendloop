{
  "id": "lendloopLoanEvt1",
  "name": "LendLoop: loan event notifications",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "lendloopErrors01",
    "saveManualExecutions": true
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lendloop-loan-events",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000001",
      "name": "Loan event webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "webhookId": "4f6c5a2e-1b7d-4c39-9e0a-2d8b7f5c1a90"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst MAX_SKEW_SECONDS = 300;\nconst request = $input.first();\nconst timestamp = request.json.headers['x-lendloop-timestamp'] ?? '';\nconst signature = request.json.headers['x-lendloop-signature'] ?? '';\n\nlet rawBody = '';\ntry {\n  rawBody = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} catch {\n  return [{ json: { valid: false } }];\n}\n\n// Same scheme Convex uses: HMAC-SHA256 over \"<timestamp>.<raw body>\".\nconst expected = 'v1=' + crypto\n  .createHmac('sha256', $env.N8N_WEBHOOK_SECRET)\n  .update(`${timestamp}.${rawBody}`)\n  .digest('hex');\nconst fresh = /^\\d+$/.test(timestamp)\n  && Math.abs(Date.now() / 1000 - Number(timestamp)) <= MAX_SKEW_SECONDS;\nconst valid = fresh\n  && signature.length === expected.length\n  && crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expected));\n\n// Only the parsed event moves on. Headers stay in the webhook node.\nreturn [{ json: valid ? { valid, event: JSON.parse(rawBody) } : { valid } }];"
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000002",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0d1e2f3-0000-4000-8000-000000000003",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000004",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"received\": true } }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000005",
      "name": "Accept",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"invalid signature\" } }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000006",
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        660,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const { type, recipientRole, recipient, tool, loan } = $json.event;\nconst appUrl = $env.LENDLOOP_APP_URL;\nconst dates = loan.startDate === loan.endDate\n  ? loan.startDate\n  : `${loan.startDate} to ${loan.endDate}`;\n\nconst messages = {\n  'loan.requested': [\n    `New request for your ${tool.name}`,\n    `A neighbour would like to borrow your ${tool.name} for ${dates}.\\n\\nApprove or decline it here: ${appUrl}/incoming`,\n  ],\n  'loan.approved': [\n    `You can borrow the ${tool.name}`,\n    `Your request for ${dates} was approved.\\n\\nDetails: ${appUrl}/requests`,\n  ],\n  'loan.declined': [\n    `Your request for the ${tool.name}`,\n    `The owner can't lend it for ${dates} this time.\\n\\nOther tools: ${appUrl}/tools`,\n  ],\n  'loan.cancelled': recipientRole === 'owner'\n    ? [\n        `Request withdrawn: ${tool.name}`,\n        `The borrower cancelled their request for ${dates}.\\n\\n${appUrl}/incoming`,\n      ]\n    : [\n        `Request cancelled: ${tool.name}`,\n        `The ${tool.name} is no longer available, so your request for ${dates} was cancelled.\\n\\n${appUrl}/tools`,\n      ],\n  'loan.returned': [\n    `Return confirmed: ${tool.name}`,\n    `Thanks for bringing back the ${tool.name}. The loan is now closed.`,\n  ],\n};\n\nif (!messages[type]) throw new Error(`Unknown event type: ${type}`);\nconst [subject, body] = messages[type];\n\nreturn [{\n  json: {\n    to: recipient.email,\n    subject,\n    text: `Hi ${recipient.firstName},\\n\\n${body}\\n\\nLendLoop`,\n  },\n}];"
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000007",
      "name": "Compose email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.LENDLOOP_FROM_EMAIL }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000008",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        200
      ],
      "credentials": {
        "smtp": {
          "id": "lendloopSmtp0001",
          "name": "LendLoop SMTP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a5519e00-0000-4000-8000-000000000009",
              "name": "status",
              "value": "sent",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000010",
      "name": "Mark sent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1320,
        100
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a5519e00-0000-4000-8000-000000000011",
              "name": "status",
              "value": "failed",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000012",
      "name": "Mark failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nfunction signForConvex(body) {\n  const timestamp = Math.floor(Date.now() / 1000).toString();\n  const signature = 'v1=' + crypto\n    .createHmac('sha256', $env.CONVEX_WEBHOOK_SECRET)\n    .update(`${timestamp}.${body}`)\n    .digest('hex');\n  return { body, timestamp, signature };\n}\n\nconst { event } = $('Verify signature').first().json;\n\n// The event id is stable across Convex retries, so the key is too.\nreturn [{\n  json: signForConvex(JSON.stringify({\n    idempotencyKey: `notify:${event.eventId}`,\n    loanId: event.loan.id,\n    kind: 'request_notification',\n    status: $json.status,\n  })),\n}];"
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000013",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL }}/n8n/automation-events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000014",
      "name": "Record in Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
