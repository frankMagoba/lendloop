{
  "id": "lendloopOverdue1",
  "name": "LendLoop: daily overdue reminders",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "lendloopErrors01",
    "saveManualExecutions": true
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000015",
      "name": "Every day at 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nfunction signForConvex(body) {\n  const timestamp = Math.floor(Date.now() / 1000).toString();\n  const signature = 'v1=' + crypto\n    .createHmac('sha256', $env.CONVEX_WEBHOOK_SECRET)\n    .update(`${timestamp}.${body}`)\n    .digest('hex');\n  return { body, timestamp, signature };\n}\n\n// A GET has no body, so the signature covers \"<timestamp>.\" only.\nreturn [{ json: signForConvex('') }];"
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000016",
      "name": "Sign request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000017",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "fieldToSplitOut": "loans",
        "options": {}
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000018",
      "name": "One item per loan",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { borrower, tool, dueDate, daysOverdue } = $json;\nconst late = daysOverdue === 1 ? '1 day' : `${daysOverdue} days`;\n\nreturn {\n  json: {\n    to: borrower.email,\n    subject: `Reminder: the ${tool.name} was due back on ${dueDate}`,\n    text: `Hi ${borrower.firstName},\\n\\nThe ${tool.name} you borrowed was due back on ${dueDate}, ${late} ago. Please return it when you can.\\n\\n${$env.LENDLOOP_APP_URL}/requests\\n\\nLendLoop`,\n  },\n};"
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000019",
      "name": "Compose reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.LENDLOOP_FROM_EMAIL }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000020",
      "name": "Send reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "lendloopSmtp0001",
          "name": "LendLoop SMTP"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a5519e00-0000-4000-8000-000000000021",
              "name": "status",
              "value": "sent",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000022",
      "name": "Mark sent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1320,
        200
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a5519e00-0000-4000-8000-000000000023",
              "name": "status",
              "value": "failed",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000024",
      "name": "Mark failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1320,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nfunction signForConvex(body) {\n  const timestamp = Math.floor(Date.now() / 1000).toString();\n  const signature = 'v1=' + crypto\n    .createHmac('sha256', $env.CONVEX_WEBHOOK_SECRET)\n    .update(`${timestamp}.${body}`)\n    .digest('hex');\n  return { body, timestamp, signature };\n}\n\nconst loan = $('One item per loan').item.json;\n\n// Convex hands out one key per loan per day, so a rerun of this\n// workflow updates the same record instead of adding another.\nreturn {\n  json: signForConvex(JSON.stringify({\n    idempotencyKey: loan.idempotencyKey,\n    loanId: loan.loanId,\n    kind: 'overdue_reminder',\n    status: $json.status,\n  })),\n};"
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000025",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL }}/n8n/automation-events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "6c1e0b7a-0000-4000-8000-000000000026",
      "name": "Record in Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Every day at 09:00": {
      "main": [
        [
          {
            "node": "Sign request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign request": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "One item per loan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per loan": {
      "main": [
        [
          {
            "node": "Compose reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compose reminder": {
      "main": [
        [
          {
            "node": "Send reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reminder": {
      "main": [
        [
          {
            "node": "Mark sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark sent": {
      "main": [
        [
          {
            "node": "Sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark failed": {
      "main": [
        [
          {
            "node": "Sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign write-back": {
      "main": [
        [
          {
            "node": "Record in Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
